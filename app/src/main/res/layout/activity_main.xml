<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <include layout="@layout/floating_bottom_nav" />

    <!-- AI Assistant floating orb trigger (52dp, navy gradient, sparkle icon) -->
    <FrameLayout
        android:id="@+id/aiAssistantOrb"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="104dp"
        android:background="@drawable/bg_assistant_orb"
        android:clickable="true"
        android:focusable="true"
        android:elevation="8dp"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sparkle"
            android:contentDescription="@string/assistant_orb_description" />
    </FrameLayout>

</FrameLayout>



