<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sr_bg_main"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingBottom="@dimen/fragment_bottom_padding"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/evidenceBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/navigation_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/evidenceScreenTitle"
            style="@style/TextStyle.Heading.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:textColor="@color/sr_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/evidenceLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/evidence_loading"
        android:textColor="@color/sr_text_secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/evidenceError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:textColor="@color/status_danger"
        android:visibility="gone" />

    <TextView
        android:id="@+id/evidenceEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/evidence_empty"
        android:textColor="@color/sr_text_secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/evidenceEventSummary"
        style="@style/TextStyle.Body.Small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:textColor="@color/sr_text_secondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/evidenceRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
