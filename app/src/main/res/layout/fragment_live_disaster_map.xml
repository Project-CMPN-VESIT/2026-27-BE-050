<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sr_bg_main"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingBottom="@dimen/fragment_bottom_padding"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/spacing_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/liveMapBackButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/navigation_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/live_map_title"
            style="@style/TextStyle.Heading.Medium"
            android:textColor="@color/sr_text_primary" />
    </LinearLayout>

    <org.osmdroid.views.MapView
        android:id="@+id/liveDisasterMap"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="@dimen/spacing_lg" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/source_status_heading"
        style="@style/TextStyle.Label.Large"
        android:textColor="@color/sr_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/spacing_sm">

        <com.google.android.material.chip.Chip
            android:id="@+id/liveFeedGlobal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_feed_global"
            android:textColor="@color/text_inverse"
            app:chipBackgroundColor="@color/sr_primary_navy"
            app:chipCornerRadius="@dimen/corner_full" />

        <com.google.android.material.chip.Chip
            android:id="@+id/liveFeedIndia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/live_feed_india"
            android:textColor="@color/sr_text_secondary"
            app:chipBackgroundColor="@color/sr_bg_card"
            app:chipCornerRadius="@dimen/corner_full"
            app:chipStrokeColor="@color/border_light"
            app:chipStrokeWidth="1dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sourceStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/liveMapLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/live_map_loading"
        android:textColor="@color/sr_text_secondary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/liveMapError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:textColor="@color/status_danger"
        android:visibility="gone" />

    <TextView
        android:id="@+id/liveMapEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/live_map_empty"
        android:textColor="@color/sr_text_secondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/liveEventsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false" />

</LinearLayout>
