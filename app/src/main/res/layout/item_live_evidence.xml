<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardBackgroundColor="@color/sr_bg_card"
    app:cardCornerRadius="@dimen/corner_2xl"
    app:cardElevation="@dimen/elevation_light"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <TextView
            android:id="@+id/evidenceSourceType"
            style="@style/TextStyle.Label.Medium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_risk_badge"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xs"
            android:textColor="@color/text_inverse" />

        <TextView
            android:id="@+id/evidenceSourceName"
            style="@style/TextStyle.Label.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/sr_text_primary" />

        <TextView
            android:id="@+id/evidenceTitle"
            style="@style/TextStyle.Body.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/sr_text_primary" />

        <TextView
            android:id="@+id/evidenceBody"
            style="@style/TextStyle.Body.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/sr_text_secondary" />

        <TextView
            android:id="@+id/evidenceTimestamp"
            style="@style/TextStyle.Body.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/sr_text_secondary" />

        <TextView
            android:id="@+id/evidenceLocation"
            style="@style/TextStyle.Body.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="@color/sr_text_secondary" />

        <TextView
            android:id="@+id/evidenceContribution"
            style="@style/TextStyle.Label.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="@color/sr_text_primary" />

        <Button
            android:id="@+id/evidenceOpenUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/evidence_open_source"
            android:textAllCaps="false" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
